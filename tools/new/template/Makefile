# __NAME__ - SAMD21 app project (generated by samd-new)
# Shared build machinery lives in the central library; only main.cpp and
# this glue file are project-local.

SPEED ?= fast

ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

# Library location: make SAMD21_LIB=/path > $SAMD21_LIB > generation-time default
ifeq ($(strip $(SAMD21_LIB)),)
SAMD21_LIB := __LIB__
endif

BUILD := $(ROOT)/build
CMAKE = cmake -S $(ROOT) -B $(BUILD) \
    -DCMAKE_TOOLCHAIN_FILE=$(SAMD21_LIB)/tools/build/toolchain.cmake \
    -DSAMD21_LIB=$(SAMD21_LIB) \
    -DPROFILE=$(SPEED)

.PHONY: all debug flash clean

all:
	$(CMAKE) && cmake --build $(BUILD)

debug:
	$(MAKE) SPEED=debug all

flash: all
	$(SAMD21_LIB)/tools/build/upload.sh $(BUILD)/firmware.bin

clean:
	rm -rf $(BUILD)
